# ---- Backend ----
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
# SQLite by default for local dev; docker-compose overrides with Postgres.
DATABASE_URL=sqlite:///./invoicelens.db
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# Demo mode leaves the API open. Set DEMO_MODE=false and API_KEY=... to require the X-API-Key header.
DEMO_MODE=true
API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# auto = pdf text layer, then tesseract for scans | pdf = text layer only | none
OCR_ENGINE=auto
TESSERACT_CMD=

CONFIDENCE_THRESHOLD=0.8
FEWSHOT_MAX_EXAMPLES=3
MOCK_SEED=42

WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=0.5
WEBHOOK_TIMEOUT_SECONDS=10

# ---- docker-compose ----
POSTGRES_USER=invoicelens
POSTGRES_PASSWORD=invoicelens
POSTGRES_DB=invoicelens

# ---- mock-erp ----
MOCK_ERP_SECRET=demo-webhook-secret

# ---- frontend ----
VITE_API_BASE_URL=
